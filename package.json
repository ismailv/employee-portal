{
  "name": "@lit/lit-starter-js",
  "private": true,
  "version": "1.0.0",
  "description": "Crud your records",
  "main": "EmployeeManagement",
  "module": "EmployeeManagement",
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lit/localize": "^0.12.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "lit": "^3.3.1",
    "sinon": "^21.0.0"
  },
  "scripts": {
    "lint": "npm run lint:lit-analyzer && npm run lint:eslint",
    "lint:eslint": "eslint '**/*.js'",
    "format": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --ignore-path ./.eslintignore --write",
    "build": "wireit",
    "serve": "web-dev-server --node-resolve --watch",
    "test": " npx vitest --environment happy-dom ",
    "test:coverage": " npx vitest --environment happy-dom --coverage ",
    "extract:messages": "lit-localize extract",
    "build:locales": "lit-localize build"
  },
  "devDependencies": {
    "@11ty/eleventy": "^1.0.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.0.0",
    "@babel/eslint-parser": "^7.17.0",
    "@custom-elements-manifest/analyzer": "^0.6.3",
    "@lit/localize-tools": "^0.8.0",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@web/dev-server": "^0.1.31",
    "@web/dev-server-legacy": "^1.0.0",
    "@web/test-runner": "^0.15.0",
    "@web/test-runner-playwright": "^0.9.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "eslint": "^8.15.0",
    "happy-dom": "^19.0.2",
    "jsdom": "^27.0.0",
    "lit-analyzer": "^1.2.1",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "rollup": "^4.18.0",
    "rollup-plugin-summary": "^2.0.1",
    "vitest": "^3.2.4"
  },
  "wireit": {
    "build": {
      "command": "lit-localize build",
      "dependencies": [
        "../../../localize:build",
        "../../../localize-tools:build"
      ],
      "files": [
        "lit-localize.json",
        "src/**",
        "xliff/**",
        "!src/generated/**"
      ],
      "output": [
        "src/generated/**"
      ]
    }
  }
}
